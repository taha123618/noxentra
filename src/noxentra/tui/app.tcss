/* src/noxentra/tui/app.tcss — single source of visual style (claude-* look) */
Screen { background: $surface; }

#nx-header {
    dock: top;
    height: auto;
    padding: 0 1;
    color: $text;
    border-bottom: solid $panel;
}

#nx-banner { dock: top; height: auto; padding: 0 1; }
#nx-logo { border: round $accent; width: auto; height: auto; padding: 0 1; color: $text; text-style: bold; }

OptionList { border: round $panel; padding: 0 1; }
OptionList > .option-list--option-highlighted { background: $boost; color: $text; }

/* list fills the middle and scrolls within itself; prompt pinned at the bottom */
#main-cats, #cat-tools, #recommend-tools, #report-engagements, #tags-list, #find-results, #skill-scroll { height: 1fr; }
#goal-steps, #engage-list { height: auto; max-height: 10; }
#tool-detail { padding: 0 1; height: auto; }
#tool-actions { height: auto; max-height: 8; }
.live-panel { height: 1fr; }
.live-status-row { height: 1; padding: 0 1; }
.live-status { width: 1fr; color: $warning; }
.live-progress { width: 24; }
.live-log { height: 1fr; border: round $panel; padding: 0 1; }
#nx-prompt { dock: bottom; height: 3; border: round $panel; padding: 0 1; }

#nx-hint { color: $text-muted; height: 1; padding: 0 1; }

UpdateModal { align: center middle; }
UpdateModal > #update-box {
    width: 80%;
    max-width: 90;
    border: round $warning;
    padding: 1 2;
    background: $panel;
}

EditModal { align: center middle; }
EditModal > #edit-box {
    width: 70%;
    border: round $accent;
    padding: 1 2;
    background: $panel;
}

PermissionModal { align: center middle; }
PermissionModal > #perm-box {
    width: 70%;
    border: round $warning;
    padding: 1 2;
    background: $panel;
}

CreateEngagementModal { align: center middle; }
CreateEngagementModal > #engage-create-box {
    width: 80%;
    max-width: 90;
    border: round $accent;
    padding: 1 2;
    background: $panel;
}
#eng-error { color: $error; height: auto; padding: 0 1; }
#eng-modal-actions { height: auto; padding-top: 1; }
#eng-modal-actions Button { margin-right: 1; }

FindingDetailModal { align: center middle; }
FindingDetailModal > #finding-detail-box {
    width: 80%;
    max-width: 96;
    border: round $accent;
    padding: 1 2;
    background: $panel;
}
#finding-detail-text { padding-bottom: 1; }

/* Floating slash-command palette: overlay lifts it above the 3-row bottom prompt
   without growing the screen (pattern verified from Textual's Select). */
CommandPalette {
    overlay: screen;
    constrain: none inside;
    max-height: 12;
    dock: bottom;
    offset-y: -3;
    width: 1fr;
    border: round $accent;
    background: $panel;
    padding: 0 1;
}
